android_app {
    name: "MotionSenseWallpapers",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "lottie",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
