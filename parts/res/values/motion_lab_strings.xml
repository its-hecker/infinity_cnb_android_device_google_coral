    <string name="motion_lab_arcade_intro">Play with air swipes and taps while this screen is open.</string>
    <string name="motion_lab_studio">Glow Theme Studio</string>
    <string name="motion_lab_studio_intro">Choose a glow style and animation speed. Apply saves your draft; Preview tries it for eight seconds.</string>
    <string name="motion_lab_training">Gesture Training Room</string>
    <string name="motion_lab_training_intro">Practice one gesture at a time with immediate radar feedback.</string>
    <string name="motion_lab_panel">Air Control Panel</string>
    <string name="motion_lab_panel_intro">Swipe to select a control, then air tap to use it. Controls work only while this page is open.</string>
