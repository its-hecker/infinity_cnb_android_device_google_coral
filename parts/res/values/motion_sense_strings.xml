    <string name="motion_sense_footer">Motion Sense detects nearby movement. It does not use your camera, mic or location.</string>
    <string name="motion_sense_unavailable_airplane">Motion Sense is unavailable because airplane mode is on</string>
    <string name="motion_sense_unavailable_saver">Motion Sense is unavailable because Battery Saver is on</string>
