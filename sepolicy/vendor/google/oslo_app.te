# oslo_app is declared in system_ext/public (coredomain); these rules need
# vendor-defined types, which system_ext policy cannot reference.

# Soli calibration (oslo.cal, tx_power.cal)
allow oslo_app persist_file:dir search;
r_dir_file(oslo_app, persist_oslo_file)

get_prop(oslo_app, vendor_aware_available_prop)
